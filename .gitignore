# Secrets — never commit
.env
*.env
!.env.example
service-account*.json
credentials*.json

# Live config: real chat ids and folder ids. Start from profiles.example.yaml.
profiles.yaml
!profiles.example.yaml

# Local state
media/*
!media/.gitkeep
# Docker bind-mount state: the queue database and downloaded brand media.
# Created by docker-compose.yml (./data:/data), so it only appears on the container path.
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
