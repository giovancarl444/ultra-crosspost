# Copy to .env and fill in. .env is gitignored and its values are never printed or logged.
#   cp .env.example .env
#
# The variable NAMES here must match the *_env keys in profiles.yaml.

# ---------------------------------------------------------------------------
# Global
# ---------------------------------------------------------------------------

# Simulate every platform post: the full flow runs, nothing is published, fake URLs are
# returned. Leave this as true until you have tested the whole loop end to end.
DRY_RUN=true

LOG_LEVEL=INFO

# Path to profiles.yaml. Optional — defaults to ./profiles.yaml
# PROFILES_FILE=profiles.yaml

# ---------------------------------------------------------------------------
# Telegram — needed from Phase 1. README → "Telegram bot token and chat id"
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Google Drive — needed from Phase 2. README → "Google Drive service account"
# Path to the service-account JSON key file. Keep it out of the repo.
# ---------------------------------------------------------------------------

GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# ---------------------------------------------------------------------------
# Discord — needed from Phase 3. README → "Discord webhook"
# The full https://discord.com/api/webhooks/... URL.
# ---------------------------------------------------------------------------

DISCORD_WEBHOOK_BRAND_A=
DISCORD_WEBHOOK_BRAND_B=

# ---------------------------------------------------------------------------
# Reddit — needed from Phase 4. README → "Reddit script app"
# ---------------------------------------------------------------------------

REDDIT_CLIENT_ID_BRAND_A=
REDDIT_CLIENT_SECRET_BRAND_A=
REDDIT_USERNAME_BRAND_A=
REDDIT_PASSWORD_BRAND_A=

REDDIT_CLIENT_ID_BRAND_B=
REDDIT_CLIENT_SECRET_BRAND_B=
REDDIT_USERNAME_BRAND_B=
REDDIT_PASSWORD_BRAND_B=

# ---------------------------------------------------------------------------
# RedGifs — needed from Phase 5. README → "RedGifs account"
# Ordinary account login; RedGifs exchanges it for a token at runtime.
# ---------------------------------------------------------------------------

REDGIFS_USERNAME_BRAND_A=
REDGIFS_PASSWORD_BRAND_A=

REDGIFS_USERNAME_BRAND_B=
REDGIFS_PASSWORD_BRAND_B=

# ---------------------------------------------------------------------------
# X — not implemented. See README → "X (deferred)".
# ---------------------------------------------------------------------------
